{
  "name": "changesets-demo",
  "private": true,
  "description": "Independent EMP domain releases with GitHub Actions and Environments",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && node --test scripts/release-summary.test.mjs",
    "test:acceptance": "pnpm -r --if-present test:acceptance",
    "release:prepare": "nx release --skip-publish && node scripts/release-summary.mjs"
  },
  "devDependencies": {
    "@nx/js": "22.5.4",
    "esbuild": "0.25.12",
    "nx": "22.5.4",
    "semver": "7.7.3",
    "yaml": "2.8.1"
  }
}
