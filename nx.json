{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "release": {
    "projects": ["billing", "payment", "wingman", "billing-api"],
    "projectsRelationship": "independent",
    "versionPlans": false,
    "version": {
      "conventionalCommits": true,
      "updateDependents": "auto",
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": { "skipLockFileUpdate": true }
    },
    "releaseTag": { "pattern": "{projectName}@v{version}", "checkAllBranchesWhen": false },
    "changelog": {
      "projectChangelogs": {
        "createRelease": false,
        "renderOptions": { "authors": true, "applyUsernameToAuthors": true, "commitReferences": true },
        "repositoryUrl": "https://github.com/janodetzel/changesets-demo"
      }
    },
    "git": { "commit": false, "tag": false }
  }
}
