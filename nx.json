{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "release": {
    "groups": {
      "billing": {
        "projects": ["billing", "billing-api"],
        "projectsRelationship": "fixed",
        "version": { "conventionalCommits": true }
      },
      "payment": {
        "projects": ["payment", "payment-api"],
        "projectsRelationship": "fixed",
        "version": { "conventionalCommits": true }
      },
      "wingman": {
        "projects": ["wingman"],
        "projectsRelationship": "fixed",
        "version": { "conventionalCommits": true }
      }
    },
    "versionPlans": false,
    "version": {
      "conventionalCommits": true,
      "updateDependents": "auto",
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": { "skipLockFileUpdate": true }
    },
    "releaseTag": { "pattern": "{releaseGroupName}@v{version}", "checkAllBranchesWhen": false },
    "changelog": {
      "projectChangelogs": {
        "createRelease": false,
        "renderOptions": { "authors": true, "applyUsernameToAuthors": true, "commitReferences": true },
        "repositoryUrl": "https://github.com/janodetzel/changesets-demo"
      }
    },
    "git": { "commit": false, "tag": false }
  }
}
